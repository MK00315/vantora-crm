# Copy this file to .env for local Docker development.
# Values below are development defaults only. Never reuse them in production.

# PostgreSQL
POSTGRES_DB=mtcrm
POSTGRES_USER=mtcrm
POSTGRES_PASSWORD=mtcrm_dev_password
POSTGRES_PORT=5433
DB_POOL_SIZE=15

# Redis
REDIS_PORT=6380

# Application ports and browser origin
FRONTEND_PORT=3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_FRONTEND_BASE_URL=http://localhost:3000
APP_PUBLIC_BASE_URL=http://localhost:3000

# Required. Generate this with scripts/init-env.ps1; never commit the generated value.
JWT_SECRET=
JWT_ISSUER=mt-crm-api
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
JWT_ACTION_TOKEN_TTL=30m
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

# Frontend (the production container proxies /api to the backend)
VITE_API_BASE_URL=/api/v1

# Local Compose captures email in Mailpit at http://localhost:8025.
MAIL_ENABLED=true
MAIL_HOST=
MAIL_PORT=1025
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@vantora.local
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=10000
MAIL_WRITE_TIMEOUT_MS=10000

# Object storage is optional locally. Local disk storage is the development fallback.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/uploads
STORAGE_MAX_BYTES_PER_TENANT=104857600
STORAGE_MAX_FILES_PER_TENANT=1000
STORAGE_MAX_UPLOADS_PER_HOUR=60
STORAGE_MAX_BYTES_TOTAL=1073741824
STORAGE_MAX_FILES_TOTAL=10000
STORAGE_MAX_UPLOADS_PER_HOUR_TOTAL=1000
STORAGE_MAX_CONCURRENT_UPLOADS=4
STORAGE_RESERVATION_TTL=1h
STORAGE_CLEANUP_CRON="0 */15 * * * *"
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Request throttles. Auth uses a bounded local limiter; authenticated mutations use Redis with a bounded fallback.
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60
MUTATION_RATE_LIMIT_PER_USER=300
MUTATION_RATE_LIMIT_PER_TENANT=2000
MUTATION_RATE_WINDOW_SECONDS=60

# Data retention and workspace/deployment quotas.
TOKEN_RETENTION=7d
TOKEN_CLEANUP_CRON="0 30 2 * * *"
PENDING_REGISTRATION_RETENTION=24h
MAX_TENANTS=10000
MAX_PENDING_REGISTRATIONS=5000
MAX_USERS_PER_TENANT=250
MAX_CUSTOMERS_PER_TENANT=100000
MAX_LEADS_PER_TENANT=100000
MAX_TASKS_PER_TENANT=250000
MAX_ACTIVITIES_PER_TENANT=1000000

# Hourly at minute zero. Spring uses six-field cron syntax including seconds.
REMINDER_CRON="0 0 * * * *"
