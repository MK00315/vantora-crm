          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('File was deleted', () => pm.response.to.have.status(200));",
                  "pm.environment.unset('fileKey');",
                  "pm.environment.unset('fileUrl');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/files?key={{fileKey}}",
              "host": ["{{baseUrl}}"],
              "path": ["files"],
              "query": [
                { "key": "key", "value": "{{fileKey}}" }
              ]
            }
          }
        }
      ]
