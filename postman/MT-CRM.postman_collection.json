{
  "info": {
    "_postman_id": "9e783f19-08ed-4bd1-bd53-59d70e7eab9e",
    "name": "Vantora CRM API",
    "description": "Runnable examples for the Enterprise Multi-Tenant CRM API through the local Nginx endpoint. Select the supplied Local environment. Registration returns 201 without a session: copy the token from the Mailpit message at http://localhost:8025 into verificationToken, run Verify email, and then run Login. Login and refresh save the access token; Postman's cookie jar manages the HttpOnly refresh token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "if (pm.info.requestName === 'Register workspace') {",
          "  const runId = `${Date.now()}-${Math.floor(Math.random() * 10000)}`;",
          "  pm.environment.set('adminEmail', `admin+${runId}@vantora.local`);",
          "  pm.environment.set('invitedEmail', `isha+${runId}@vantora.local`);",
          "  pm.environment.unset('accessToken');",
          "  pm.environment.unset('verificationToken');",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "description": "Run Register, copy the verification token from Mailpit into the environment, run Verify email, then run Login. Refresh and logout use the `mtcrm_refresh` cookie saved automatically by Postman.",
      "item": [
        {
          "name": "Register workspace",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Workspace was registered', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body).to.have.property('message');",
                  "pm.expect(body).not.to.have.property('accessToken');",
                  "pm.expect(pm.response.headers.has('Set-Cookie')).to.equal(false);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Vantora Demo\",\n  \"firstName\": \"Maya\",\n  \"lastName\": \"Rao\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"Vantora123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Resend verification",
          "description": "Use this only when the original verification token expired. The response is generic. Open {{mailpitUrl}}, then copy the token query parameter from the newest verification link into verificationToken.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Generic resend response returned', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json()).to.have.property('message');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/resend-verification",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "resend-verification"]
            }
          }
        },
        {
          "name": "Verify email",
          "description": "Set verificationToken to the token query parameter from the Mailpit verification link before sending this request.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Email was verified', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json()).to.have.property('message');",
                  "pm.environment.unset('verificationToken');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verificationToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-email",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-email"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login succeeded', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set('accessToken', body.accessToken);",
                  "pm.environment.set('userId', body.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"Vantora123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Current session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Refresh session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Session was refreshed', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.environment.set('accessToken', body.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "Request password reset",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-password"]
            }
          }
        }
      ]
    },
