    {
      "name": "Files",
      "description": "The example uses a small inline CSV, so it also works in a collection run without selecting a local file.",
      "item": [
        {
          "name": "Upload file",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('File was uploaded', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.environment.set('fileKey', body.key);",
                  "pm.environment.set('fileUrl', body.url);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data; boundary=vantora-boundary"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "--vantora-boundary\r\nContent-Disposition: form-data; name=\"file\"; filename=\"sample-contacts.csv\"\r\nContent-Type: text/csv\r\n\r\nname,email\r\nSample Contact,sample@example.com\r\n--vantora-boundary--\r\n"
            },
            "url": {
              "raw": "{{baseUrl}}/files",
              "host": ["{{baseUrl}}"],
              "path": ["files"]
            }
          }
        },
        {
          "name": "Read uploaded file",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{fileUrl}}",
              "host": ["{{fileUrl}}"]
            }
          }
        },
        {
